# Copy to .env next to the compose file (git ignores it). docker compose reads it automatically.
# See "Deployment" in the README for the NAS setup.

# User and group the backend runs as, and that owns ./data.
# On a Synology, the IDs of a DSM user (`id <user>`); default: the image's own user 999:999.
PUID=999
PGID=999

# Port of the app on the NAS: http://<NAS_IP>:8083
PORT=8083

# Container names: <prefix>-backend and <prefix>-frontend
CONTAINER_PREFIX=fitness

TZ=Europe/Zurich

# Signs login tokens (required). Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# How long a login stays valid, in days
JWT_EXPIRE_DAYS=30

# First start only: the passwords of user1 and user2 (at most 72 bytes each).
# Remove them after the first start; change passwords later with backend/set_password.py.
INITIAL_PASSWORD_user1=
INITIAL_PASSWORD_user2=
