# Copy to .env next to the compose file (git ignores it). docker compose reads it automatically.
# See "Deployment" in the README for the NAS setup.

# User and group the backend runs as, and that owns ./data.
# On a Synology, the IDs of a DSM user (`id <user>`); default: the image's own user 999:999.
PUID=999
PGID=999

# Port of the app on the NAS; DSM's reverse proxy serves it as https://fitness.local.<domain>
PORT=8083

# Container names: <prefix>-backend and <prefix>-frontend
CONTAINER_PREFIX=fitness

TZ=Europe/Zurich

# The family hub (FrankAndreas/family-hub) does the login. How the backend reaches it:
HUB_URL=http://<NAS_IP>:8086
# Where browsers log in (the hub's home address):
HUB_PUBLIC_URL=https://home.local.<domain>
# This app's key in the hub (Einstellungen → Apps); it must match the tile's App-Schlüssel
HUB_APP_KEY=fitness
